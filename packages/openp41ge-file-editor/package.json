{
  "name": "openp41ge-file-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "lit": "^3.3.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "scripts": {
    "build": "vite build && npx tsc --emitDeclarationOnly --outDir dist 2>/dev/null",
    "dev": "vite build --watch",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
