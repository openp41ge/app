{
  "name": "openp41ge-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "files": ["dist"],
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css",
    "build:inline": "node scripts/inline-css.mjs",
    "build": "npm run build:css && npm run build:inline && vite build",
    "storybook": "./node_modules/.bin/storybook dev -p 6006",
    "build:storybook": "./node_modules/.bin/storybook build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/web-components-vite": "^8.6.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
