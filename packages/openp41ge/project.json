{
  "name": "openp41ge",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-electron"],
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "vite build",
          "tsc -p tsconfig.node.json",
          "cp electron/preload.cjs dist-electron/electron/preload.cjs"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "build:renderer": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "build:electron": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-electron"],
      "options": {
        "command": "tsc -p tsconfig.node.json && cp electron/preload.cjs dist-electron/electron/preload.cjs",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist dist-electron",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.unit.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.integration.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test:contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUST_LOG=error vitest run --config vitest.contract.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev:vite": {
      "executor": "@nx/vite:dev-server",
      "dependsOn": ["^build"],
      "options": {
        "buildTarget": "openp41ge:build"
      }
    },
    "dev:electron": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:electron"],
      "options": {
        "commands": ["node scripts/wait-for-vite.mjs", "electron ."],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build:electron"],
      "options": {
        "command": "concurrently --kill-others \"vite\" \"node scripts/wait-for-vite.mjs && electron .\"",
        "cwd": "{projectRoot}"
      }
    }
  }
}
