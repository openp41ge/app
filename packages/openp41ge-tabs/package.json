{
  "name": "openp41ge-tabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npx tsc --emitDeclarationOnly --outDir dist 2>/dev/null",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "playwright test --config test/e2e/playwright.config.mjs",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
