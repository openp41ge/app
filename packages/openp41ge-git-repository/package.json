{
  "name": "openp41ge-git-repository",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite build --watch",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build": "vite build && npx tsc --emitDeclarationOnly --outDir dist 2>/dev/null",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
