{
  "name": "openp41ge-json-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json-editor": {
      "types": "./dist/json-editor.d.ts",
      "import": "./dist/json-editor.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npx tsc --emitDeclarationOnly --outDir dist 2>/dev/null",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "openp41ge-editor-engine": "workspace:*",
    "openp41ge-editor-gutter": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "jsdom": "^29.1.1"
  }
}
