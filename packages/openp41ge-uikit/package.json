{
  "name": "openp41ge-uikit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./file-editor": {
      "types": "./dist/file-editor/index.d.ts",
      "import": "./dist/file-editor/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "files": ["dist"],
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css",
    "build:inline": "node scripts/inline-css.mjs",
    "build": "npm run build:css && npm run build:inline && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "openp41ge-piece-tree": "workspace:*",
    "openp41ge-syntax-highlighting": "workspace:*",
    "openp41ge-tabs": "workspace:*",
    "openp41ge-editor-engine": "workspace:*",
    "openp41ge-git": "workspace:*",
    "vscode-textmate": "^9.3.2",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
