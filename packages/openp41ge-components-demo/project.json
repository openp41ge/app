/**
 * Openp41ge Components Demo — project configuration.
 *
 * Targets:
 *   storybook        Run Storybook dev server on port 6006
 *   build:storybook  Build Storybook static site
 *   clean            Remove dist/
 */

{
  "name": "openp41ge-components-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec storybook dev -p 6006",
        "cwd": "{projectRoot}"
      }
    },
    "build:storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec storybook build",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist/ storybook-static/",
        "cwd": "{projectRoot}"
      }
    }
  }
}
