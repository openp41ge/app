    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "jsdom": "^29.1.1"
  }
}
