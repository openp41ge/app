{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["+@public"],
  "ignoreIssues": {
    "package.json": ["unresolved"],
    "packages/openp41ge/src/layout/types.ts": ["duplicates"],
    "packages/openp41ge/src/renderer/global.d.ts": ["unresolved"],
    "packages/openp41ge-editor-engine/src/global.d.ts": ["unresolved"],
    "storybook/.storybook/main.ts": ["unresolved"]
  },
  "workspaces": {
    ".": {
      "project": ["!packages/**"],
      "ignoreDependencies": [
        "@earendil-works/pi-coding-agent",
        "@xterm/addon-fit",
        "concurrently",
        "lit",
        "zod"
      ]
    },
    "packages/openp41ge": {
      "entry": ["src/main/index.ts", "electron/main.ts", "electron/preload.cjs"],
      "project": ["src/**/*.ts", "electron/**/*.{ts,cjs}"],
      "ignoreDependencies": ["ts-node", "@xterm/xterm", "@xterm/addon-fit"],
      "ignore": [
        "src/renderer/components/openp41ge-bottom-bar.ts",
        "src/renderer/components/sidebar-views/index.ts",
        "src/renderer/interfaces/index.ts",
        "src/renderer/models/index.ts",
        "src/renderer/models/text-content-model.ts",
        "src/renderer/models/test-text-content-model.ts",
        "src/renderer/models/text-decoration-provider.ts",
        "src/renderer/models/text-edit.ts",
        "src/renderer/models/text-model-events.ts",
        "src/renderer/models/text-model.ts",

        "src/renderer/services/index.ts",
        "src/layout/index.ts",
        "src/index.ts",
        "electron/trpc/index.ts",

        // Terminal tab app: unregistered for now but kept for easy re-enable.
        "src/renderer/apps/terminal/index.ts",
        "src/renderer/apps/terminal/terminal-controller.ts",

        // Legacy in-repo syntax highlighting, superseded by the
        // openp41ge-syntax-highlighting package.
        "src/renderer/controllers/syntax-highlight.ts",
        "src/renderer/controllers/syntax-highlight/index.ts",
        "src/renderer/controllers/syntax-highlight/registry.ts",
        "src/renderer/controllers/syntax-highlight/tokenizers/*.ts"
      ],
      "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
      }
    },
    "packages/openp41ge-uikit": {
      "project": ["src/**/*.ts"]
    },
    "packages/openp41ge-terminal": {
      "project": ["src/**/*.ts"]
    },
    "packages/openp41ge-editor-engine": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/global.d.ts"]
    },
    "packages/openp41ge-agents": {
      "project": ["src/**/*.ts"]
    },
    "packages/openp41ge-logger": {
      "project": ["src/**/*.ts"],
      "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
      }
    },
    "storybook": {
      "entry": [
        ".storybook/main.ts",
        ".storybook/extensions/event-log/preset.ts",
        ".storybook/extensions/event-log/manager.tsx"
      ],
      "project": [".storybook/**/*"],
      "ignoreDependencies": ["openp41ge-uikit"]
    },
    "demos/openp41ge-tabs-demo": {
      "ignoreDependencies": ["openp41ge-uikit"]
    }
  }
}
