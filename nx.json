{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/vite.config.*",
        "{projectRoot}/package.json",
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-electron"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/**/*",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/*.config.*",
        "{projectRoot}/package.json"
      ],
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/unit/**/*",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/vitest*.config.*",
        "{projectRoot}/package.json"
      ],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/integration/**/*",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/vitest*.config.*",
        "{projectRoot}/package.json"
      ],
      "cache": true
    },
    // Lint is cheap (oxlint, seconds) and must never be served stale — a cached
    // ESLint/oxlint pass once hid real violations. Always run it fresh.
    "lint": {
      "inputs": ["{workspaceRoot}/packages/**/*", "{workspaceRoot}/demos/**/*"],
      "cache": false
    }
  },
  "defaultBase": "master",
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "analytics": false
}
