{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/vite.config.*",
        "{projectRoot}/package.json",
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/dist-electron"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "lint": {
      "inputs": ["{workspaceRoot}/packages/**/*"],
      "cache": true
    }
  },
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "analytics": false
}
